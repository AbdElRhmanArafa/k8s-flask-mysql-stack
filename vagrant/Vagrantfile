# -*- mode: ruby -*-
# vi: set ft=ruby :

Vagrant.configure("2") do |config|
  # Base box for all VMs
  config.vm.box = "generic/ubuntu2004"
  config.vm.box_check_update = false

  # Disable default synced folder
  config.vm.synced_folder ".", "/vagrant", disabled: true

  # Master node configuration
  config.vm.define "master" do |master|
    master.vm.hostname = "master"
    master.vm.network "private_network", ip: "192.168.121.10"
    
    master.vm.provider "virtualbox" do |vb|
      vb.name = "k8s-master"
      vb.memory = 4096  
      vb.cpus = 2       
      
      # Enable nested virtualization if needed
      vb.customize ["modifyvm", :id, "--nested-hw-virt", "on"]
    end

    # Provisioning script for master
    master.vm.provision "shell", inline: <<-SHELL
      # Create ubuntu user if it doesn't exist
      if ! id "ubuntu" &>/dev/null; then
          useradd -m -s /bin/bash ubuntu
          echo "ubuntu:it" | chpasswd
      fi
      
      # Add ubuntu user to sudo group with no password
      echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers
      
      # Enable password authentication in SSH
      sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/g' /etc/ssh/sshd_config
      systemctl restart sshd
      
      # Install Python 
      apt-get update
      apt-get install -y python3 python3-pip
      
      echo "Master node basic setup completed"
    SHELL
  end

  # Worker node configuration
  config.vm.define "worker" do |worker|
    worker.vm.hostname = "worker"
    worker.vm.network "private_network", ip: "192.168.121.11"
    
    worker.vm.provider "virtualbox" do |vb|
      vb.name = "k8s-worker"
      vb.memory = 2048  
      vb.cpus = 1       
    end

    # Provisioning script for worker
    worker.vm.provision "shell", inline: <<-SHELL
      # Create ubuntu user if it doesn't exist
      if ! id "ubuntu" &>/dev/null; then
          useradd -m -s /bin/bash ubuntu
          echo "ubuntu:it" | chpasswd
      fi
      
      # Add ubuntu user to sudo group with no password
      echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers
      
      # Enable password authentication in SSH
      sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/g' /etc/ssh/sshd_config
      systemctl restart sshd
      
      # Install Python 
      apt-get update
      apt-get install -y python3 python3-pip
      
      echo "Worker node basic setup completed"
    SHELL
  end

  # NFS Server configuration
  config.vm.define "nfs-server" do |nfs|
    nfs.vm.hostname = "nfs-server"
    nfs.vm.network "private_network", ip: "192.168.121.12"
    
    nfs.vm.provider "virtualbox" do |vb|
      vb.name = "k8s-nfs-server"
      vb.memory = 2048  
      vb.cpus = 1       
      # Create additional disk for NFS storage (30GB)
      unless File.exist?("./nfs-storage.vdi")
        vb.customize ['createhd', '--filename', './nfs-storage.vdi', '--variant', 'Fixed', '--size', 30 * 1024]
      end
      vb.customize ['storageattach', :id, '--storagectl', 'SCSI', '--port', 2, '--device', 0, '--type', 'hdd', '--medium', './nfs-storage.vdi']
    end

    # Provisioning script for NFS server
    nfs.vm.provision "shell", inline: <<-SHELL
      # Create ubuntu user if it doesn't exist
      if ! id "ubuntu" &>/dev/null; then
          useradd -m -s /bin/bash ubuntu
          echo "ubuntu:it" | chpasswd
      fi
      
      # Add ubuntu user to sudo group with no password
      echo 'ubuntu ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers
      
      # Enable password authentication in SSH
      sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/g' /etc/ssh/sshd_config
      systemctl restart sshd
      
      # Install Python 
      apt-get update
      apt-get install -y python3 python3-pip
      
      echo "NFS server basic setup completed"
    SHELL
  end

end
